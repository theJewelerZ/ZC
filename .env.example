# Public site behavior
NEXT_PUBLIC_SITE_URL=https://www.zarkaconstruction.com
NEXT_PUBLIC_ANALYTICS_ENABLED=true
# Use true only for the canonical Production deployment; previews default to false.
NEXT_PUBLIC_SEARCH_INDEXING_ENABLED=false

# Contact delivery. All three values are required to enable form submission.
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=
CONTACT_FROM_EMAIL=

# Optional Cloudflare Turnstile protection. Configure both values together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional rate-limit hardening. The secret is used only to hash request fingerprints.
CONTACT_RATE_LIMIT_SECRET=
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=900000
